# ── Never commit ─────────────────────────────────────────────────────────────
# Local configuration holds the user's Nexus API key. It lives in the app data
# directory, not here, but a stray copy must never be tracked.
settings.json
.env
.env.*
!.env.example
*.db
*.db-wal
*.db-shm

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]

# ── Build output ─────────────────────────────────────────────────────────────
build/
dist/
src-tauri/target/
src-tauri/sidecars/
src-tauri/src/rust-ue-tools/target/
extracted_wheel/
*.spec.bak

# ── Tool caches ──────────────────────────────────────────────────────────────
.ruff_cache/
.pytest_cache/
.pytest-data/
coverage/
*.log

# ── Editor / OS ──────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── Local scratch ────────────────────────────────────────────────────────────
graphify-out/
*.local
